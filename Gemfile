# Seulement utile pour prévisualiser le site sur ton PC (voir README).
# GitHub Pages n'en a pas besoin pour publier.
source "https://rubygems.org"
# Même version de Jekyll que GitHub Pages, sans le reste (installation rapide).
gem "jekyll", "~> 3.10.0"
gem "kramdown-parser-gfm"
gem "webrick"
# Nécessaire sous Windows
gem "tzinfo-data", platforms: [:mingw, :x64_mingw, :mswin]
gem "wdm", ">= 0.1.0", platforms: [:mingw, :x64_mingw, :mswin]
